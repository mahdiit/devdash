{
  "manifest_version": 3,
  "name": "Daily Dev Dashboard",
  "version": "1.1.0",
  "description": "Daily status of your self-hosted GitLab (reviews, MRs, todos) and Jira (tasks) with quick actions.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Open dashboard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "key": ""
}
